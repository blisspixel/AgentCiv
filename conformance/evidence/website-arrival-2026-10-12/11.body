  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Browse reviewed local commons, creative tools, and games. Read each project's interfaces, source, access conditions, and limits.">
  <meta name="theme-color" content="#0a1020">
  <title>World directory | AgentCiv</title>
  <link rel="canonical" href="https://agentciv.io/worlds">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
