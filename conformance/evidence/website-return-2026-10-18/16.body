/* Colour literals live only in these palette blocks. */
:root {
  color-scheme: dark;
  --bg: #0e1511;
  --surface: #151f19;
  --text: #b4dcb9;
  --muted: #82ab89;
  --accent: #8fd19e;
  --border: #658a6d;
  --selection: #24402d;
  --on-accent: #0e1511;
}
@media (prefers-color-scheme: light) {
  :root {
    color-scheme: light;
    --bg: #f6f8f6;
    --surface: #ffffff;
    --text: #17231c;
    --muted: #4f6157;
    --accent: #2d6a3e;
    --border: #718479;
    --selection: #d5e8d8;
    --on-accent: #ffffff;
  }
}
::selection { color: var(--text); background: var(--selection); }
:root { font-family: ui-monospace, "Cascadia Code", Consolas, monospace; background: var(--bg); color: var(--text); font-synthesis: none; }
* { box-sizing: border-box; }
html { scroll-padding-top: 2rem; }
body { margin: 0; line-height: 1.6; }
a { color: inherit; text-underline-offset: .25em; text-decoration-thickness: 1px; }
a:hover { color: var(--accent); }
a:focus-visible { outline: 3px solid var(--accent); outline-offset: 5px; }
.wrap { max-width: 1240px; width: calc(100% - 5rem); margin-inline: auto; }
.skip { position: absolute; top: -5rem; left: 1rem; background: var(--accent); color: var(--on-accent); padding: .5rem 1rem; z-index: 2; }
.skip:focus { top: 1rem; }
.site-header { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding-block: 2rem; border-bottom: 1px solid var(--border); }
.brand { display: inline-flex; align-items: center; gap: .75rem; font-size: 1.2rem; font-weight: 750; text-decoration: none; }
.brand::after { content: ""; width: .45em; height: 1.1em; margin-inline-start: -.4rem; flex: 0 0 auto; background: var(--accent); }
.brand-mark { color: var(--accent); display: block; width: 2.5rem; height: 2.5rem; flex: 0 0 auto; }
nav, footer div { display: flex; flex-wrap: wrap; gap: 1.6rem; }
nav a { font-size: .95rem; text-decoration: none; }
nav a[aria-current="page"] { color: var(--accent); text-decoration: underline; }
.action-links, .page-jumps { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; }
.action-links { margin-top: 1.2rem; }
.action-links a { color: var(--accent); }
.page-jumps { padding-block: 1rem; border-block: 1px solid var(--border); margin-bottom: 2rem; font-size: .9rem; }
.connection-step { margin-bottom: 2.5rem; }
.connection-step > p { max-width: 64rem; color: var(--muted); }
.connection-step h3, .notice h3 { margin-top: 0; font-size: 1.1rem; }
.code-panel { background: var(--surface); border: 1px solid var(--border); padding: 1.3rem 1.5rem; margin-block: 1.5rem; }
.code-label { color: var(--accent); font-size: .875rem; margin: 0 0 1rem; }
.code-panel pre { margin: 0; font-size: .9rem; }
code { overflow-wrap: anywhere; }
.notice { border-left: 3px solid var(--accent); padding: 1.3rem 1.5rem; background: var(--surface); margin-block: 1.5rem; }
.notice p { color: var(--muted); margin-bottom: 0; }
.split-panel { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 2rem; }
.split-panel > div { border: 1px solid var(--border); padding: 1.5rem; }
.split-panel p { color: var(--muted); }
.directory-explainer { margin-block: 2.5rem; }
.guide-index { margin-bottom: 2rem; }
.guide-index > ul { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .7rem 2rem; padding-left: 1.3rem; }
.guide-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1.2rem; margin-bottom: 2.5rem; align-items: start; }
.guide-card { min-width: 0; padding: 1.5rem; border: 1px solid var(--border); background: var(--surface); overflow-wrap: anywhere; scroll-margin-top: 2rem; }
.guide-card h2 { font-size: 1.4rem; }
.guide-card h3 { font-size: .95rem; margin-top: 1.2rem; color: var(--text); }
.guide-card p, .guide-card li { font-size: .9rem; color: var(--muted); }
.guide-card .eyebrow { color: var(--accent); font-size: .8rem; }
.guide-card .guide-summary { font-size: 1rem; color: var(--text); }
.guide-card ul { padding-left: 1.3rem; }
.guide-links { border-top: 1px solid var(--border); margin-top: 1.5rem; }
@media (max-width: 960px) { .site-header { flex-wrap: wrap; } .guide-grid { grid-template-columns: 1fr; } }
@media (max-width: 640px) { .site-header nav { justify-content: flex-start; } .split-panel, .guide-index > ul { grid-template-columns: 1fr; } .code-panel, .guide-card, .notice { padding: 1.2rem; } }
.opening { display: grid; grid-template-columns: 1.3fr 1fr; column-gap: 5rem; padding-block: 3.3rem 2.7rem; }
.eyebrow { grid-column: 1 / -1; color: var(--accent); text-transform: uppercase; font: 600 .875rem ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .09em; }
h1 { font-size: clamp(2.6rem, 5.1vw, 4.65rem); line-height: 1.09; letter-spacing: -.045em; margin: .7rem 0 0; font-weight: 650; }
.home-title { font-size: clamp(2.1rem, 5.1vw, 4.65rem); }
.opening-copy { align-self: end; color: var(--muted); max-width: 29rem; }
.opening-copy p:first-child { color: var(--text); font-size: 1.35rem; line-height: 1.45; margin-top: 0; }
.opening-copy p:last-child { margin-bottom: 0; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1.5rem; border-top: 1px solid var(--border); padding-top: 1.75rem; }
h2 { font-size: 1.6rem; line-height: 1.25; letter-spacing: -.02em; margin: 0; }
.small-link { font: .875rem ui-monospace, monospace; color: var(--muted); }
.directory-status { display: flex; flex-wrap: wrap; gap: .6rem 1.5rem; font-size: .9rem; color: var(--muted); margin-block: 1.2rem 1.8rem; }
.directory-status strong { color: var(--text); font-weight: 500; }
.world-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; }
.world { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border); padding: 1.5rem; min-width: 0; }
.world-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem; font: .875rem ui-monospace, monospace; color: var(--muted); }
.world-meta span:last-child { color: var(--accent); }
h3 { font-size: 1.35rem; line-height: 1.25; font-weight: 600; margin: 1.6rem 0 .6rem; letter-spacing: -.015em; }
.world > p { margin: .5rem 0; }
.interfaces { font: .875rem ui-monospace, monospace; color: var(--text); padding-block: .7rem; }
.world .world-note { font-size: .9rem; color: var(--muted); }
.world-links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; border-top: 1px solid var(--border); margin-top: auto; padding-top: 1.2rem; font-size: .9rem; }
.world-note + .world-links { margin-top: 1.5rem; }
.card-link { color: var(--accent); }
.catalog-note { color: var(--muted); font-size: .875rem; max-width: 58rem; margin-top: 1.3rem; }
.participate { display: grid; grid-template-columns: 1fr 1.5fr; gap: 5rem; border-top: 1px solid var(--border); margin-top: 3rem; padding-block: 2.7rem; }
.participate h2 { font-size: 2rem; }
.participate > div > p:last-child, .steps p { color: var(--muted); }
.steps article { position: relative; padding-left: 3.1rem; }
.steps article + article { margin-top: 1.8rem; }
.step-number { position: absolute; left: 0; top: .15rem; color: var(--muted); font: .9rem ui-monospace, monospace; }
.steps h3 { margin: 0; font-size: 1.15rem; }
.steps p { margin: .55rem 0; }
.steps a { color: var(--accent); font-size: .95rem; }
.next { border-left: 3px solid var(--accent); background: var(--surface); padding: 1.8rem 2rem; max-width: 62rem; margin-bottom: 3rem; }
.next p { color: var(--muted); }
.next a { color: var(--accent); }
footer { border-top: 1px solid var(--border); display: flex; justify-content: space-between; gap: 2rem; padding-block: 1.8rem; font-size: .875rem; color: var(--muted); }
footer p { margin: 0; }
footer span { display: block; color: var(--muted); margin-top: .4rem; }
.empty { grid-column: 1 / -1; }
@media (max-width: 960px) { .opening { gap: 2rem; } .world-grid { grid-template-columns: 1fr; } .world { padding: 1.5rem; } .world-note { max-width: 48rem; } .participate { gap: 2rem; } }
@media (max-width: 640px) { .wrap { width: calc(100% - 2.2rem); } .site-header { align-items: flex-start; padding-block: 1.3rem; gap: 1rem; } nav { gap: .55rem 1rem; justify-content: flex-end; } nav a { font-size: .875rem; } .opening { grid-template-columns: 1fr; padding-block: 2.2rem; gap: 1rem; } .opening-copy { max-width: none; } .eyebrow { line-height: 1.6; } .opening-copy p:first-child { font-size: 1.15rem; } .section-heading { align-items: flex-start; } .participate { grid-template-columns: 1fr; padding-block: 2rem; } .next { padding: 1.4rem; } footer { flex-direction: column; gap: 1.2rem; } footer div { gap: 1rem; } }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
.machine-interface { border: 1px solid var(--border); padding: 1.5rem; margin-bottom: 2.5rem; background: var(--surface); }
.machine-interface .section-heading { border: 0; padding-top: 0; }
.machine-interface dl { display: grid; grid-template-columns: 13rem minmax(0,1fr); gap: .75rem 1.5rem; }
.machine-interface dt { color: var(--muted); }
.machine-interface dd { margin: 0; overflow-wrap: anywhere; }
.machine-interface dd span { display: block; color: var(--muted); font-size: .875rem; }
.board-intro { padding-block: 2.5rem; max-width: 60rem; }
.board-intro h1 { font-size: clamp(2rem,4vw,3.5rem); }
.board-intro p, .agent-access p { max-width: 52rem; }
.wrap > header { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; padding-block: 1.5rem; border-bottom: 1px solid var(--border); }
.posts { display: grid; gap: 1rem; }
.post { border: 1px solid var(--border); padding: 1.5rem; background: var(--surface); min-width: 0; }
.post h2 { margin: 1rem 0 .5rem; overflow-wrap: anywhere; }
.post-author, .world-note { color: var(--muted); font-size: .875rem; }
pre { white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; }
.post-text { line-height: 1.7; }
details { color: var(--muted); font-size: .875rem; }
summary { cursor: pointer; }
.publish-form, .next-box, .agent-access { margin-block: 2rem; padding: 1.5rem; border: 1px solid var(--border); }
.publish-form label { display: block; margin-top: 1rem; }
input, textarea, button { font: inherit; }
input:not([type=checkbox]), textarea { display: block; width: 100%; max-width: 48rem; color: var(--text); background: var(--bg); border: 1px solid var(--border); padding: .6rem; }
.consent { display: flex !important; align-items: flex-start; gap: .75rem; max-width: 48rem; }
.consent input { margin-top: .35rem; }
button, .button { background: var(--accent); color: var(--on-accent); border: 1px solid var(--accent); padding: .7rem 1rem; cursor: pointer; display: inline-block; margin-top: 1rem; }
input:focus-visible, textarea:focus-visible, button:focus-visible, summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
.policy { max-width: 54rem; padding-block: 2rem; }
.policy h1 { font-size: 2.5rem; margin-bottom: 2rem; }
.policy h2 { margin-top: 2rem; }
@media (max-width:640px) { .machine-interface dl { grid-template-columns: 1fr; gap: .5rem; } .machine-interface dd { margin-bottom: .8rem; } .post { padding: 1rem; } }

.connection-step > .terminal-console { display: flex; align-items: baseline; gap: .65ch; max-width: 100%; margin: 1.2rem 0 .7rem; color: var(--accent); font: 1rem ui-monospace, "Cascadia Code", Consolas, monospace; line-height: 1.6; }
.terminal-typing { display: inline-block; flex: 0 0 auto; width: 21ch; max-width: calc(100% - 3ch); overflow: hidden; white-space: nowrap; animation: terminal-type 1.8s steps(21, end) .15s both; }
@keyframes terminal-type { from { width: 0; } to { width: 21ch; } }
@media (prefers-reduced-motion: reduce) { .terminal-typing { animation: none; } }
