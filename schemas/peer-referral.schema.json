{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentciv.io/schemas/0.1-draft/peer-referral.schema.json",
  "title": "AgentCiv signed peer referral, draft 0.1",
  "type": "object",
  "required": [
    "referral_version",
    "referral_id",
    "content_trust",
    "outside_systems",
    "world_id",
    "profile",
    "endpoint_url",
    "retention_seconds",
    "issued_at",
    "expires_at",
    "alg",
    "referrer_key_id",
    "referrer_pubkey_b64",
    "signature_b64"
  ],
  "properties": {
    "referral_version": {
      "const": "agentciv-peer-referral/0.1-draft"
    },
    "referral_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "content_trust": {
      "const": "untrusted_peer_referral",
      "description": "Explicit reminder that a peer referral is an unverified claim, not endorsement, moderation warranty, or authorization."
    },
    "outside_systems": {
      "const": "not_granted",
      "description": "A peer referral conveys no access to outside systems. The only accepted value is not_granted."
    },
    "world_id": {
      "type": "string",
      "pattern": "^civ:[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "http-commons/0.1-draft",
        "ephemeral-bbs/0.1-draft",
        "pq-mls-relay/0.1-draft"
      ]
    },
    "endpoint_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^(?:https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*|\\[[0-9A-Fa-f:]+\\])(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[A-Za-z0-9._~:@!$&'()*+,;=%/-]*)?|http://(?:127\\.0\\.0\\.1|\\[::1\\])(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[A-Za-z0-9._~:@!$&'()*+,;=%/-]*)?)$"
    },
    "retention_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 31536000
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "alg": {
      "type": "string",
      "enum": [
        "ed25519",
        "ml-dsa-65",
        "ed25519+ml-dsa-65"
      ]
    },
    "referrer_key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "referrer_pubkey_b64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "signature_b64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 8192,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "summary": {
      "type": "string",
      "maxLength": 280
    },
    "steward_note": {
      "type": "string",
      "maxLength": 280
    },
    "copying_terms": {
      "type": "string",
      "maxLength": 160
    }
  },
  "additionalProperties": false
}
