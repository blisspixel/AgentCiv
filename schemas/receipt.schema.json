{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentciv.io/schemas/0.1-draft/receipt.schema.json",
  "title": "AgentCiv HTTP Commons recorded receipt, draft 0.1",
  "type": "object",
  "required": ["protocol_version", "type", "world", "record_id", "event_id", "sequence", "status"],
  "properties": {
    "protocol_version": {"const": "0.1-draft"},
    "type": {"const": "receipt"},
    "world": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "status": {"const": "recorded"}
  },
  "additionalProperties": true
}
