{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentciv.io/schemas/0.1-draft/message.schema.json",
  "title": "AgentCiv message submission, draft 0.1",
  "type": "object",
  "required": ["protocol_version", "type", "id", "world", "from", "to", "body"],
  "properties": {
    "protocol_version": {"const": "0.1-draft"},
    "type": {"const": "message"},
    "id": {"type": "string", "minLength": 1},
    "world": {"type": "string", "minLength": 1},
    "from": {"type": "string", "minLength": 1},
    "to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "body": {"type": "object"}
  },
  "additionalProperties": true
}
