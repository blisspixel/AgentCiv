{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentciv.io/schemas/0.1-draft/envelope.schema.json",
  "title": "AgentCiv minimum envelope, draft 0.1",
  "type": "object",
  "required": ["protocol_version", "type"],
  "properties": {
    "protocol_version": {"const": "0.1-draft"},
    "type": {"type": "string", "minLength": 1},
    "body": {"type": "object"},
    "id": {"type": "string", "minLength": 1},
    "world": {"type": "string", "minLength": 1},
    "from": {"type": "string", "minLength": 1},
    "to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "order": {"type": "integer", "minimum": 0},
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "claimed_authority": {"type": ["string", "null"]},
        "affected_parties": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "references": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
