{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentciv.io/schemas/0.1-draft/artifact.schema.json",
  "title": "AgentCiv artifact descriptor, draft 0.1",
  "type": "object",
  "required": ["protocol_version", "type", "id", "world", "creator", "media_type"],
  "properties": {
    "protocol_version": {"const": "0.1-draft"},
    "type": {"const": "artifact"},
    "id": {"type": "string", "minLength": 1},
    "world": {"type": "string", "minLength": 1},
    "creator": {"type": "string", "minLength": 1},
    "media_type": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "minLength": 1},
    "location": {"type": "string", "format": "uri"}
  },
  "additionalProperties": true
}
