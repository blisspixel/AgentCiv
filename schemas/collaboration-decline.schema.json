{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentciv.io/schemas/0.1-draft/collaboration-decline.schema.json",
  "title": "AgentCiv collaboration decline, draft 0.1",
  "type": "object",
  "required": ["protocol_version", "type", "id", "world", "from", "to", "artifact_id", "target_from", "revision", "body"],
  "properties": {
    "protocol_version": {"const": "0.1-draft"},
    "type": {"const": "decline"},
    "id": {"type": "string", "minLength": 1},
    "world": {"type": "string", "minLength": 1},
    "from": {"type": "string", "minLength": 1},
    "to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact_id": {"type": "string", "minLength": 1},
    "target_from": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "body": {"type": "object"}
  },
  "additionalProperties": true
}
