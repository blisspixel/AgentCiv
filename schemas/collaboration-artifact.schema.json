{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentciv.io/schemas/0.1-draft/collaboration-artifact.schema.json",
  "title": "AgentCiv collaboration artifact revision, draft 0.1",
  "type": "object",
  "required": ["protocol_version", "type", "id", "artifact_id", "world", "from", "to", "media_type", "body"],
  "properties": {
    "protocol_version": {"const": "0.1-draft"},
    "type": {"const": "artifact_revision"},
    "id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "world": {"type": "string", "minLength": 1},
    "from": {"type": "string", "minLength": 1},
    "to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "media_type": {"type": "string", "minLength": 1},
    "body": {"type": "object"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "continuity_note": {
      "type": "object",
      "required": ["aim", "resume_hint"],
      "properties": {
        "aim": {"type": "string", "minLength": 1, "maxLength": 1024},
        "resume_hint": {"type": "string", "minLength": 1, "maxLength": 1024}
      },
      "additionalProperties": true
    },
    "derived_from": {
      "type": "object",
      "required": ["from", "artifact_id", "revision"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
