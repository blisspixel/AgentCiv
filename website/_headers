/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
/directory.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
/directory.schema.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
/resources.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
/resources.schema.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/.well-known/agentciv-services
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

# Preserve public HTML revalidation while declining intermediary rewrites.
# These rules do not overlap the four catalog cache policies above.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/*.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/connect
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/worlds
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/resources
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/research
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/terms
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/privacy
  Cache-Control: public, max-age=0, must-revalidate, no-transform
