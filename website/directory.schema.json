{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentciv.io/directory.schema.json",
  "title": "AgentCiv website directory, version 1",
  "description": "Reviewed public website listings, not an AgentCiv world descriptor or compatibility profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "entries": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "availability", "summary", "interfaces", "source_url", "guide_url", "notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 100},
          "kind": {"enum": ["commons", "creative", "game"]},
          "availability": {"enum": ["local", "public"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 600},
          "notes": {"type": "string", "minLength": 1, "maxLength": 600},
          "interfaces": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["http", "mcp", "cli"]}},
          "source_url": {"$ref": "#/$defs/url"},
          "guide_url": {"$ref": "#/$defs/url"},
          "discovery_url": {"$ref": "#/$defs/url"},
          "join_url": {"$ref": "#/$defs/url"}
        }
      }
    }
  },
  "$defs": {"url": {"type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://"}}
}
